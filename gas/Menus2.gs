/**
 * 上の食材とメニューを、いまのシートに足す。
 * 何度実行しても同じ id を上書きするだけなので安全。
 */
function addSeptemberMenus() {
  const foods = SEED_FOODS_2.map(function (r) {
    return { 食材名: r[0], 栄養素分類: r[1], 月齢OK目安: r[2], 標準の調達先: r[3] };
  });
  h_upsert({ sheet: 'foods', rows: foods });

  const header = SHEETS.menus;
  const menus = SEED_MENUS_2.map(function (r) {
    const o = {};
    header.forEach(function (h, i) { o[h] = r[i] === undefined ? '' : r[i]; });
    return o;
  });
  h_upsert({ sheet: 'menus', rows: menus });

  SpreadsheetApp.getUi().alert(
    '食材を' + foods.length + '件、メニューを' + menus.length + '件 足しました。'
  );
}

/**
 * ChatGPTが「これまでのNG食材」として除外していたものを、
 * 大人3人の「苦手な食材」に入れる。
 * 違っていたら、アプリの 設定タブ → 苦手な食材 で直せる。
 */
function seedKnownDislikes() {
  const NG = ['生姜', '生しいたけ', 'えのきだけ', 'しめじ', 'マッシュルーム'];
  const members = readSheet_('members').filter(function (m) {
    return m['区分'] === '大人' || m['区分'] === 'ライト';
  });

  const rows = [];
  members.forEach(function (m) {
    NG.forEach(function (f) {
      rows.push({
        id: 'ng-' + m['id'] + '-' + f,
        member_id: m['id'],
        食材名: f,
        評価: '×',
        メモ: 'ChatGPTの献立で「NG食材」として除外されていたもの。違っていたら直してください。',
      });
    });
  });

  h_upsert({ sheet: 'prefs', rows: rows });
  SpreadsheetApp.getUi().alert(
    '大人' + members.length + '人に、生姜ときのこ類を「×」として入れました（' + rows.length + '件）。\n'
    + 'アプリの 設定 → 苦手な食材 で直せます。\n\n'
    + '※「カレー味」「生野菜」は食材ではなく味・状態なので入れていません。'
  );
}
