function seedSeptember() {
  const known = {};
  readSheet_('menus').forEach(function (m) { known[m['id']] = m['メニュー名']; });

  // 足りないメニューがあれば、入れる前に止める
  const missing = [];
  SEPTEMBER_PLAN.forEach(function (d) {
    if (d[1] && !known[d[1]]) missing.push(d[0] + ' 昼 ' + d[1]);
    d[2].forEach(function (id) { if (!known[id]) missing.push(d[0] + ' 夜 ' + id); });
  });
  if (missing.length) {
    SpreadsheetApp.getUi().alert(
      'メニューが足りません。先に addSeptemberMenus を実行してください。\n\n'
      + missing.slice(0, 10).join('\n')
    );
    return;
  }

  const rows = [];
  SEPTEMBER_PLAN.forEach(function (d) {
    if (d[1]) rows.push({ 日付: d[0], 食事区分: '昼', member_id: '', menu_id: d[1], 状態: '予定' });
    d[2].forEach(function (id) {
      rows.push({ 日付: d[0], 食事区分: '夜', member_id: '', menu_id: id, 状態: '予定' });
    });
  });

  replacePlanRange_('2026-09-01', '2026-09-30', rows);

  SpreadsheetApp.getUi().alert(
    '9月の献立を入れました（' + rows.length + '件）。\n\n'
    + '元の表から直したのは次の3点です。\n'
    + '・土日の昼を外した（あとで「昼は月〜金だけ」と決めたため）\n'
    + '・昼のラタトゥイユを別の野菜に替えた（9/11・9/16・9/21）\n'
    + '・昼の鮭のパン粉焼きを味噌マヨ焼きに替えた（9/2・9/22）\n\n'
    + 'アプリの「計画」タブでマスを押せば差し替えられます。'
  );
}
